{
  "Codegeex.RepoIndex": true,
  "Codegeex.SidebarUI.LanguagePreference": "English",
  "Codegeex.CommitMessage.LanguagePreference": "English",
  "chat.mcp.assisted.nuget.enabled": false,
  "python.REPL.enableREPLSmartSend": false,

  // Build output, hidden from the explorer so it stops sitting next to the
  // source it was built from — main.js under main.ts reads like a duplicate,
  // and it is not one.
  //
  // These are NOT deletable. main.js is what Electron actually loads, preload.js
  // is what installs window.WOLFSPACE, and app.build.js is the renderer the page
  // fetches. All three are gitignored and rebuilt by `npm run app`, so removing
  // them from disk only makes them come straight back.
  //
  // Each is generated by scripts/build-*.cjs from the .ts beside it, and each
  // says so on its first line: "GENERATED FILE — DO NOT EDIT."
  "files.exclude": {
    "electron/main.js": true,
    "electron/preload.js": true,
    "public/app.build.js": true
  },

  // Still searchable. Hiding them in the tree is about not mistaking them for
  // sources; a grep for something that only appears in the build output should
  // still find it.
  "search.exclude": {},

  // Nothing here is a source file, so an accidental save must not reformat one
  // and make the staleness check disagree with the builder.
  "files.readonlyInclude": {
    "electron/main.js": true,
    "electron/preload.js": true,
    "public/app.build.js": true
  }
}
