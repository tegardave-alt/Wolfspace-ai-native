{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  // Only the sources. preload.js and main.js are both GENERATED output —
  // scripts/build-preload.cjs and scripts/build-main.cjs write them — so they are
  // never type-checked here; their .ts sources are.
  "include": ["preload.ts", "main.ts"],
  "exclude": ["node_modules"]
}
