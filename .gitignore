node_modules/
cloud-keys.json
workspace/
dist-app/
_agent_backups/

# Profil CPU dari pengawas beku (scripts/profil-beku.cjs).
# Berisi nama fungsi + jalur berkas mesin ini; jangan ikut ter-commit.
_profil/

# Jurnal temuan agent: catatan per-mesin tentang berkas yang sudah dibaca.
.wolfspace/temuan/

# Persetujuan plugin: keputusan PER-MESIN, bukan bagian dari kode.
# Ikut ter-commit berarti meng-clone repo ini = mewarisi izin milik orang lain.
plugins/_disetujui.json
dev.bat
sync-installed.ps1
sync-installed.bat

# Runtime artifacts
.wolfspace/
public/uploads/
_archive/web/uploads/
_archive/_temp/
.server_last_good.cjs

# Secrets: MCP config berisi token — jangan dilacak (pakai mcp.example.json sbg template)
config/mcp.json
# File runtime PID tracker MCP — dibuat otomatis saat server start, bukan untuk di-commit
config/.mcp-pids.json
config/.mcp-pids/
# File tempel kredensial sementara (mis. codeRabbit.py, "worker api .py"). Pernah
# ada di root repo berisi API key mentah — sekali ter-commit, kunci masuk riwayat
# git permanen. Simpan kunci di ~/.wolfspace/cloud-keys.json, bukan di file repo.
codeRabbit.py
*api*.py

# Artefak uji beban (dihasilkan ulang oleh scripts/*-probe.js)
load-report.md
electron-load-report.md
agent-load-report.md
agent-leak-report.md

# Stempel versi yang ditulis peluncur sesudah sinkronisasi ke WSL.
# Lokal per-mesin dan per-deploy, jangan ikut ter-commit.
.wolfspace-version.json
