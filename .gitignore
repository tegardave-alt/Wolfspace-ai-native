node_modules/
cloud-keys.json
workspace/
dist-app/
_agent_backups/

# Profil CPU dari pengawas beku (scripts/profil-beku.cjs).
# Berisi nama fungsi + jalur berkas mesin ini; jangan ikut ter-commit.
_profil/
*.cpuprofile

# Heap snapshot adalah SALINAN ISI MEMORI proses, dan proses ini memegang kunci
# API cloud sebagai string biasa. Satu berkas yang lolos ke repo publik = kunci
# hidup masuk riwayat git selamanya. Berkas ini justru dibuat saat menyelidiki
# anomali memori — saat perhatian sedang tertuju ke hal lain.
*.heapsnapshot

# Log runtime: jejak jalur mesin ini, kadang argumen perintah. _crash.log,
# server.log, dan server_err.log terlanjur terlacak sejak lama; pola ini
# menghentikan yang BARU, tapi yang lama perlu `git rm --cached` sendiri.
*.log

# Jurnal temuan agent: catatan per-mesin tentang berkas yang sudah dibaca.
.wolfspace/temuan/

# Persetujuan plugin: keputusan PER-MESIN, bukan bagian dari kode.
# Ikut ter-commit berarti meng-clone repo ini = mewarisi izin milik orang lain.
plugins/_disetujui.json
dev.bat
sync-installed.ps1
sync-installed.bat

# Runtime artifacts
.wolfspace/
public/uploads/
_archive/web/uploads/
_archive/_temp/
.server_last_good.cjs

# Secrets: MCP config berisi token — jangan dilacak (pakai mcp.example.json sbg template)
config/mcp.json
# File runtime PID tracker MCP — dibuat otomatis saat server start, bukan untuk di-commit
config/.mcp-pids.json
config/.mcp-pids/
# File tempel kredensial sementara (mis. codeRabbit.py, "worker api .py"). Pernah
# ada di root repo berisi API key mentah — sekali ter-commit, kunci masuk riwayat
# git permanen. Simpan kunci di ~/.wolfspace/cloud-keys.json, bukan di file repo.
codeRabbit.py
*api*.py

# Artefak uji beban (dihasilkan ulang oleh scripts/*-probe.js)
load-report.md
electron-load-report.md
agent-load-report.md
agent-leak-report.md

# Stempel versi yang ditulis peluncur sesudah sinkronisasi ke WSL.
# Lokal per-mesin dan per-deploy, jangan ikut ter-commit.
.wolfspace-version.json

# Berkas skrip perintah bash saat jalur AppContainer aktif (lihat _dirSkripAc)
.wolfspace-cmd/

# Peluncur AppContainer: sumbernya di-commit, binernya tidak.
# Repo ini publik, dan biner yang tak bisa dibaca orang bukan sesuatu
# yang pantas dibagikan begitu saja. Bangun dengan scripts/appcontainer/build.cmd
scripts/appcontainer/AcLaunch.exe

# Adapter DAP js-debug: diambil scripts/ambil-js-debug.cjs dari rilis GitHub
# (microsoft/vscode-js-debug, MIT). 2,5 MB hasil unduhan, bukan sumber yang
# ditulis di sini — jadi ia diambil ulang, bukan disimpan di repo.
vendor/js-debug/

# Aset pra-kompres, hasil scripts/kompres-aset.cjs — dihasilkan, bukan sumber.
public/**/*.br
public/**/*.gz

# Python worker artefacts (services/agent-python).
__pycache__/
*.pyc
.pytest_cache/
