{
  "name": "WOLFSPACE",
  "version": "0.1.0",
  "description": "An open-source AI coding chat that proves its code by actually running it — model guesses, your CPU judges.",
  "main": "server.cjs",
  "type": "commonjs",
  "bin": {
    "WOLFSPACE": "server.cjs"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "app": "node scripts/build-aclaunch.cjs && node scripts/build-preload.cjs && node scripts/build-main.cjs && node scripts/build-app.cjs && node scripts/app.cjs",
    "app:wsl": "node scripts/wsl-app.cjs",
    "dist": "node scripts/build-aclaunch.cjs && node scripts/build-preload.cjs && node scripts/build-main.cjs && node scripts/build-app.cjs && electron-builder --win",
    "live": "browser-sync start --proxy localhost:8090 --files \"public/**/*\" --no-open",
    "test": "jest --verbose --detectOpenHandles --passWithNoTests",
    "stress": "node scripts/stress.cjs",
    "test:watch": "jest --watch --verbose",
    "prepare": "husky",
    "vendor:three": "node scripts/three/build.cjs",
    "typecheck": "tsc -p agent/jsconfig.json && tsc -p public/tsconfig.json && tsc -p packages/contracts/tsconfig.json && tsc -p server/tsconfig.json && tsc -p electron/tsconfig.json && tsc -p core/tsconfig.json && tsc -p agent/tsconfig.json && tsc -p tsconfig.server.json",
    "profil": "node scripts/profil-beku.cjs",
    "build:preload": "node scripts/build-preload.cjs",
    "build:main": "node scripts/build-main.cjs",
    "ww": "node -r ./scripts/ts-register.cjs scripts/ww.ts",
    "build:app": "node scripts/build-app.cjs",
    "build:aclaunch": "node scripts/build-aclaunch.cjs"
  },
  "keywords": [
    "ai",
    "llm",
    "coding-assistant",
    "code-execution",
    "verification",
    "byok",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tegardave-alt/Wolfspace-ai-native.git"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@playwright/test": "^1.61.1",
    "@xyflow/react": "^12.11.2",
    "browser-sync": "^3.0.4",
    "electron": "^33.4.11",
    "electron-builder": "25.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4"
  },
  "trustedDependencies": [
    "electron",
    "electron-builder"
  ],
  "build": {
    "appId": "com.WOLFSPACE.app",
    "productName": "WOLFSPACE",
    "npmRebuild": false,
    "files": [
      "electron/**",
      "core.js",
      "server.cjs",
      "server.ts",
      "agent/**",
      "server/**",
      "scripts/ww.ts",
      "scripts/ts-register.cjs",
      "core/**",
      "public/**",
      "config.json",
      "package.json"
    ],
    "asarUnpack": [
      "core.js",
      "server.cjs",
      "server.ts",
      "agent/**",
      "server/**",
      "scripts/ww.ts",
      "scripts/ts-register.cjs",
      "core/**",
      "public/**",
      "config.json",
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WOLFSPACE"
    }
  },
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "cytoscape": "^3.34.0",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0"
  },
  "lint-staged": {
    "*.{cjs,js,mjs}": [
      "node --check",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ],
    "*.{jsx,tsx,ts}": [
      "prettier --write"
    ]
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/_agent_backups/",
      "<rootDir>/artifacts/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/_agent_backups/"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-jest.cjs"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/tests/transformer-ts.cjs",
      "^.+\\.(js|jsx|cjs|mjs)$": "babel-jest"
    }
  }
}
