{
  "name": "WOLFSPACE",
  "version": "0.1.0",
  "description": "A local, open-source AI coding chat that proves its code by actually running it — model guesses, your CPU judges.",
  "main": "server.cjs",
  "type": "commonjs",
  "bin": {
    "WOLFSPACE": "server.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "app": "node scripts/app.cjs",
    "app:opt": "electron --js-flags=\"--max-old-space-size=512 --expose-gc\" --disable-http-cache . ",
    "dist": "electron-builder --win",
    "live": "browser-sync start --proxy localhost:8090 --files \"public/**/*\" --no-open",
    "test": "jest --verbose --detectOpenHandles --passWithNoTests",
    "test:watch": "jest --watch --verbose",
    "test:cov": "jest --coverage --verbose",
    "check": "node scripts/check-env.cjs",
    "setup": "node scripts/setup-app.cjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "path": "^0.12.7",
    "fs": "^0.0.1-security",
    "cors": "^2.8.5",
    "body-parser": "^1.20.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.0",
    "langgraph": "^0.0.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "zod": "^3.23.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "semver": "^7.6.0",
    "node-fetch": "^3.3.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "browser-sync": "^3.0.0"
  }
}
