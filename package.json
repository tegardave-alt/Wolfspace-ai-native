{
  "name": "WOLFSPACE",
  "version": "0.1.0",
  "description": "A local, open-source AI coding chat that proves its code by actually running it — model guesses, your CPU judges.",
  "main": "server.cjs",
  "type": "commonjs",
  "bin": {
    "WOLFSPACE": "server.cjs"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "app": "node scripts/app.cjs",
    "app:opt": "electron --js-flags=\"--max-old-space-size=512 --expose-gc\" --disable-http-cache . ",
    "dist": "electron-builder --win",
    "live": "browser-sync start --proxy localhost:8090 --files \"public/**/*\" --no-open",
    "test": "jest --verbose --detectOpenHandles --passWithNoTests",
    "test:watch": "jest --watch --verbose",
    "prepare": "husky",
    "start:bypass": "node start.cjs",
    "vendor:reactflow": "node scripts/reactflow/build.cjs",
    "vendor:three": "node scripts/three/build.cjs"
  },
  "keywords": [
    "ai",
    "llm",
    "coding-assistant",
    "code-execution",
    "verification",
    "local-first",
    "llama.cpp",
    "byok",
    "gguf",
    "huggingface",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tegardave-alt/Wolfspace-ai-native.git"
  },
  "devDependencies": {
    "@dagrejs/dagre"
  }
}