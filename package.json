{
  "name": "WOLFSPACE",
  "version": "0.1.0",
  "description": "A local, open-source AI coding chat that proves its code by actually running it — model guesses, your CPU judges.",
  "main": "server.cjs",
  "type": "commonjs",
  "bin": {
    "WOLFSPACE": "server.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "app": "node scripts/app.cjs",
    "app:opt": "electron --js-flags=\"--max-old-space-size=512 --expose-gc\" --disable-http-cache . ",
    "dist": "electron-builder --win",
    "live": "browser-sync start --proxy localhost:8090 --files \"public/**/*\" --no-open",
    "test": "jest --verbose --detectOpenHandles --passWithNoTests",
    "test:watch": "jest --watch --verbose",
    "test:ci": "jest --ci --verbose --silent --passWithNoTests",
    "c8": "c8 --reporter=text --reporter=lcov --all node server.cjs",
    "c8:check": "c8 check-coverage --lines 80",
    "postinstall": "node scripts/postinstall.cjs",
    "postinstall:ci": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ws": "^8.18.2",
    "@xterm/xterm": "^5.6.0",
    "xterm-addon-fit": "^0.10.0",
    "xterm-addon-web-links": "^0.11.0",
    "xterm-addon-search": "^0.17.0",
    "xterm-addon-unicode11": "^0.10.0",
    "xterm-addon-webgl": "^0.18.0",
    "uuid": "^10.0.0",
    "marked": "^15.0.7",
    "highlight.js": "^11.11.0",
    "mermaid": "^11.6.0",
    "katex": "^0.16.21",
    "diff": "^7.0.0",
    "chokidar": "^4.0.3",
    "nodemon": "^3.1.9",
    "dotenv": "^16.4.7",
    "cli-progress": "^3.12.0",
    "axios": "^1.7.9",
    "@langchain/community": "^0.3.32",
    "@langchain/core": "^0.3.43",
    "@langchain/langgraph": "^0.2.57",
    "@langchain/openai": "^0.5.1",
    "langchain": "^0.3.19",
    "zod": "^3.24.3",
    "cheerio": "^1.0.0",
    "puppeteer": "^24.4.0",
    "fast-xml-parser": "^5.0.7",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "mime-types": "^2.1.35",
    "tree-kill": "^1.2.2",
    "open": "^10.1.0",
    "get-port": "^7.1.0",
    "portfinder": "^1.0.32",
    "minimatch": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.11.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "c8": "^10.1.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 2,
    "roots": [
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "js",
      "cjs",
      "json"
    ]
  },
  "build": {
    "appId": "com.wolfspace.app",
    "productName": "WOLFSPACE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!.github/**",
      "!.gitignore",
      "!.env*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
